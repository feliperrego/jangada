{
  "name": "@feliperrego/jangada",
  "version": "0.1.0",
  "description": "Jangada: design system em React com tokens, componentes acessíveis e testes.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/jangada.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "storybook dev -p 6006",
    "build": "pnpm tokens && tsc -p tsconfig.json --noEmit && vite build",
    "build-storybook": "pnpm tokens && storybook build -o storybook-static",
    "test": "pnpm tokens && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.12"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test": "8.6.14",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "storybook": "8.6.14",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-dts": "4.5.4",
    "vitest": "3.2.4"
  }
}
