{
  "$description": "Fonte única dos tokens da Jangada. scripts/build-tokens.mjs gera src/styles/tokens.css e src/tokens.ts.",
  "palette": {
    "mar": {
      "50": "#E8F6F5", "100": "#C6EAE7", "200": "#95D6D1", "300": "#5CBDB6", "400": "#2FA39B",
      "500": "#12867F", "600": "#0C6C67", "700": "#0B5652", "800": "#0C4542", "900": "#0B3533", "950": "#052020"
    },
    "areia": {
      "0": "#FFFFFF", "50": "#FAF8F5", "100": "#F2EEE8", "200": "#E4DED5", "300": "#CEC5B8", "400": "#A99F92",
      "500": "#82796D", "600": "#5F574D", "700": "#463F37", "800": "#2E2924", "900": "#1C1916", "950": "#12100E"
    },
    "sol": { "100": "#FFF1D6", "300": "#F5C04E", "700": "#8A5606", "900": "#3D2703" },
    "coral": { "100": "#FDE4E1", "300": "#F08A80", "600": "#B83227", "900": "#4A140F" },
    "folha": { "100": "#DFF5E5", "300": "#5FD08F", "700": "#17683E", "900": "#0A2E1B" }
  },
  "color": {
    "bg":               { "light": "areia.50",  "dark": "areia.950" },
    "surface":          { "light": "areia.0",   "dark": "areia.900" },
    "surface-sunken":   { "light": "areia.100", "dark": "#0B0A09" },
    "border":           { "light": "areia.200", "dark": "areia.800" },
    "border-strong":    { "light": "areia.500", "dark": "areia.500" },
    "text":             { "light": "areia.900", "dark": "areia.50" },
    "text-muted":       { "light": "areia.600", "dark": "areia.400" },
    "text-disabled":    { "light": "areia.400", "dark": "areia.600" },
    "primary":          { "light": "mar.600",   "dark": "mar.300" },
    "primary-hover":    { "light": "mar.700",   "dark": "mar.200" },
    "primary-subtle":   { "light": "mar.50",    "dark": "mar.900" },
    "on-primary":       { "light": "areia.0",   "dark": "mar.950" },
    "focus-ring":       { "light": "mar.600",   "dark": "mar.300" },
    "danger":           { "light": "coral.600", "dark": "coral.300" },
    "danger-subtle":    { "light": "coral.100", "dark": "coral.900" },
    "on-danger":        { "light": "areia.0",   "dark": "coral.900" },
    "success":          { "light": "folha.700", "dark": "folha.300" },
    "success-subtle":   { "light": "folha.100", "dark": "folha.900" },
    "warning":          { "light": "sol.700",   "dark": "sol.300" },
    "warning-subtle":   { "light": "sol.100",   "dark": "sol.900" },
    "overlay":          { "light": "rgba(18, 16, 14, 0.48)", "dark": "rgba(0, 0, 0, 0.64)" }
  },
  "contrast": {
    "$description": "Pares texto/fundo que precisam passar no WCAG AA. tests/contrast.test.ts confere todos, nos dois temas.",
    "text": [
      ["text", "bg"], ["text", "surface"], ["text", "surface-sunken"],
      ["text-muted", "bg"], ["text-muted", "surface"],
      ["on-primary", "primary"], ["on-primary", "primary-hover"],
      ["on-danger", "danger"],
      ["primary", "surface"], ["primary", "primary-subtle"],
      ["danger", "surface"], ["danger", "danger-subtle"],
      ["success", "surface"], ["success", "success-subtle"],
      ["warning", "surface"], ["warning", "warning-subtle"]
    ],
    "ui": [
      ["focus-ring", "bg"], ["focus-ring", "surface"], ["border-strong", "surface"]
    ]
  },
  "font": {
    "sans": "\"Instrument Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "font-size": { "xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.125rem", "xl": "1.25rem", "2xl": "1.5rem", "3xl": "1.875rem" },
  "font-weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
  "line-height": { "tight": "1.2", "normal": "1.5" },
  "space": { "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem", "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem" },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px", "full": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(18, 16, 14, 0.08)",
    "md": "0 4px 12px rgba(18, 16, 14, 0.10)",
    "lg": "0 16px 40px rgba(18, 16, 14, 0.18)"
  },
  "duration": { "fast": "120ms", "base": "200ms" },
  "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" },
  "control-height": { "sm": "2rem", "md": "2.5rem", "lg": "3rem" }
}
